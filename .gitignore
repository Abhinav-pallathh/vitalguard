venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated data is NOT committed. synth.py is deterministic per seed, so the
# generator plus the seed IS the dataset -- 4.6 MB of reproducible CSV in git
# would be pure waste. Regenerate with:  python make_data.py
data/*.csv

# Real device recordings are kept out of git by default until we have decided
# what is safe to publish. These are physiological recordings of real people.
data/recordings/

# PlatformIO build output and its downloaded libs -- reproducible from
# platformio.ini, and the toolchain lives in ~/.platformio, not here.
firmware/.pio/

# Offline pip cache. Local convenience, not source. See OFFLINE.md.
wheelhouse/

# Extracted WESAD subjects: ~870 MB each, regenerated from WESAD.zip on demand.
data/wesad/WESAD/*/*.pkl

# Flash backup of the board as it arrived (Sujan sketch). 4 MB binary, kept on
# disk, not in a repo whose .git is already 2.6 GB. See docs/ notes for restore.
firmware/backup/

# The WESAD dataset. 2.1 GB zip + 930 MB pickles -- these were committed once
# and made the repo unpushable (GitHub hard-rejects blobs over 100 MB); the
# history was rewritten with git-filter-repo on 2026-09-04 to remove them.
# Download separately: https://ubicomp.eti.uni-siegen.de/home/datasets/icmi18/
data/wesad/
